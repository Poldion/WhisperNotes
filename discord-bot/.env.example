# Nach discord-bot/.env kopieren und ausfüllen (die .env wird nicht ins Git-Repository übernommen).
# Token: https://discord.com/developers/applications → deine Anwendung → Bot → Reset Token
DISCORD_TOKEN=

# WhisperNotes-Wrapper
WHISPERNOTES_URL=http://127.0.0.1:8000
# Nur nötig, wenn in WhisperNotes ein API-Schlüssel gesetzt ist (Einstellungen → Zugang)
# WHISPERNOTES_API_KEY=
# Link zum Dashboard in den Zusammenfassungs-Posts – nur setzen, wenn es für alle im Discord erreichbar ist
# DASHBOARD_URL=https://whispernotes.example.org/dashboard/

# Aufnahme
# MAX_RECORDING_HOURS=6
# EMPTY_CHANNEL_STOP_SECONDS=60
# Spuren nach erfolgreichem Upload behalten (Standard: löschen, der Wrapper hat sie)
# KEEP_RECORDINGS=false
# RECORDINGS_DIR=
