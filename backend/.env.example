# WhisperNotes – Konfiguration ohne Docker, z. B. auf einem Mac (nach backend/.env kopieren)

# --- whisper.cpp -----------------------------------------------------------
WHISPER_COMMAND=/Users/DEINNAME/whisper.cpp/build/bin/whisper-server
WHISPER_MODEL=/Users/DEINNAME/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
# Weitere ggml-*.bin im selben Ordner sind im Dashboard auswählbar (setup_mac.sh lädt large-v3-q5_0 dazu).
# WHISPER_MODELS_DIR=/Users/DEINNAME/whisper.cpp/models
# Modell für die /v1-API (Home Assistant & Co.), Dateiname aus dem Modellordner; leer = laufendes/Standardmodell
# API_WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=de
WHISPER_PORT=8080
WHISPER_THREADS=4
# Zusätzliche Argumente für whisper-server, z. B. Flash-Attention:
# WHISPER_EXTRA_ARGS=-fa

# Sekunden
STARTUP_TIMEOUT=30
INFERENCE_TIMEOUT=180
IDLE_TIMEOUT=120

# --- Audio -----------------------------------------------------------------
FFMPEG_BINARY=/opt/homebrew/bin/ffmpeg
FFPROBE_BINARY=/opt/homebrew/bin/ffprobe
CHUNK_SECONDS=300
CHUNK_OVERLAP_SECONDS=10
# Max. Speicher für hochgeladene Audiodateien. Bei Überschreitung wird das Audio der ältesten
# abgeschlossenen Aufnahmen gelöscht (Transkripte/Zusammenfassungen bleiben). 0 = unbegrenzt.
AUDIO_STORAGE_MAX_GB=10

# --- Sprechererkennung -----------------------------------------------------
# Engine: sherpa (Standard, CPU) oder pyannote (pyannote.audio community-1, GPU/MPS).
# Für pyannote: HuggingFace-Konto, Nutzungsbedingungen auf
# https://huggingface.co/pyannote/speaker-diarization-community-1 akzeptieren, Lese-Token unter
# https://huggingface.co/settings/tokens erstellen und hier eintragen. deploy/setup_mac.sh installiert
# die pyannote-Erweiterung (~1–2 GB) dann automatisch.
# HF_TOKEN=
# DIARIZATION_ENGINE=sherpa
# PYANNOTE_DEVICE=mps
# Welche Kombination am besten trennt, zeigt: uv run python tools/diarize_benchmark.py --job <id> --speakers <n>
# DIARIZATION_SEGMENTATION_MODEL=models/sherpa-onnx-pyannote-segmentation-3-0/model.onnx   (Standard, MIT)
#   Alternative: models/sherpa-onnx-reverb-diarization-v1/model.int8.onnx  (Rev-Lizenz: nur privat/nicht-kommerziell)
# DIARIZATION_EMBEDDING_MODEL=models/wespeaker_en_voxceleb_resnet34_LM.onnx
#   Alternativen: models/wespeaker_en_voxceleb_CAM++_LM.onnx, models/3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx
# cpu oder coreml (Neural Engine/GPU)
# DIARIZATION_PROVIDER=cpu
# DIARIZATION_THREADS=4
# Kurze Sprecherwechsel mitten im Redefluss glätten (Sekunden, 0 = aus)
# DIARIZATION_SMOOTH_SECONDS=1.0

# --- Ollama ----------------------------------------------------------------
# Ollama (oder ein Proxy davor, z. B. OllamaProxy)
OLLAMA_URL=http://localhost:11434
# Festes Modell für Zusammenfassungen; leer = automatisch das aktuell geladene Modell (/api/ps):
# OLLAMA_MODEL=qwen2.5:7b
# Nur bei „automatisch“, falls gerade kein Modell geladen ist (leer lassen = Job meldet Fehler):
# OLLAMA_FALLBACK_MODEL=qwen2.5:7b
# Kontextgröße gibt der Proxy vor (forced_options). Nur setzen, wenn der Wrapper sie erzwingen soll:
# OLLAMA_NUM_CTX=16384
# Zeichen pro LLM-Aufruf (≈ 9k Tokens bei 30000, passend zu 16k Kontext)
MAP_CHUNK_CHARS=30000

# --- Hooks -----------------------------------------------------------------
# Postprocessing jeder API-Transkription über Ollama (pro Request per Header X-Postprocess: true/false)
POSTPROCESS_ENABLED=false
# off | metadata (nur Requests mit X-Speaker-Name/X-Session-Id/…) | all
LOGBOOK_MODE=metadata

# Sprachaktivitätserkennung vor Whisper (Silero, models/silero_vad.onnx): nur Sprachstellen gehen an Whisper.
# VAD_ENABLED=true
# VAD_THRESHOLD=0.35   # höher = strenger, leise Einwürfe fallen eher weg

# --- BasaltNotes (Notiz-App mit KI-Kurator) ---
# Fertige Zusammenfassungen gehen automatisch in den Eingang. Token in BasaltNotes unter
# Einstellungen → API-Tokens anlegen: Rechte „Eingang“ + „Lesen“, Vaults dnd + notizen.
# Mac ohne Bildschirm: macOS sperrt Python den Zugriff auf andere Geräte im Heimnetz →
#   bash deploy/basalt_tunnel.sh nas.local 4400   und dann BASALT_URL=http://127.0.0.1:4401,
#   BASALT_PUBLIC_URL=http://nas.local:4400 (für Links)
# BASALT_URL=http://nas.local:4400
# BASALT_TOKEN=bn_…
# BASALT_VAULT_DND=dnd
# BASALT_VAULT_STANDARD=notizen      # leer = normale Aufnahmen nicht exportieren
# BASALT_CURATE=auto                 # auto | review (alles als Vorschlag) | none (nur ablegen)
# PUBLIC_URL=http://whispernotes.local:8000   # Adresse von WhisperNotes für Links aus BasaltNotes
