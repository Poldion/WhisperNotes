# Variablen für docker compose (Kopie als docker/.env) – nicht für WhisperNotes selbst (→ whispernotes.env)
# Gruppen-IDs der GPU-Gerätedateien auf dem Host: `getent group video render`
VIDEO_GID=44
RENDER_GID=992
# WN_PORT=8000
# WN_DATA=./data          # Daten + Modelle (Volume), relativ zu docker/
# WN_GPU=vulkan           # vulkan | cpu | cuda (besser: compose.cpu.yml / compose.nvidia.yml)
# WN_CUDA_ARCHS=89        # nur mit compose.nvidia.yml: eigene GPU-Generation, spart Bauzeit
# WN_PYANNOTE=1
# WN_TORCH_INDEX=https://repo.amd.com/rocm/whl/gfx1151/   # ohne AMD-GPU: https://download.pytorch.org/whl/cpu
# WN_IMAGE=poldion/whispernotes:latest   # fertiges Image statt selbst bauen (Varianten :nvidia, :cpu)
