# Discord-Bot im Container – Kopie als docker/discord.env anlegen.
# WHISPERNOTES_URL setzt compose.yml (http://whispernotes:8000).
DISCORD_TOKEN=
# Nur nötig, wenn in WhisperNotes ein API-Schlüssel gesetzt ist (Einstellungen → Zugang)
# WHISPERNOTES_API_KEY=
# Link zum Dashboard in den Zusammenfassungs-Posts – nur setzen, wenn es für alle im Discord erreichbar ist
# DASHBOARD_URL=https://whispernotes.example.org/dashboard/
# MAX_RECORDING_HOURS=6
# EMPTY_CHANNEL_STOP_SECONDS=60
