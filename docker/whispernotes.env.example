# WhisperNotes im Container – Kopie als docker/whispernotes.env anlegen und anpassen.
# Pfade (Modelle, Daten) sind im Image schon gesetzt; hier nur, was zu deiner Umgebung gehört.
# Alles Weitere lässt sich auch im Dashboard unter „Einstellungen“ ändern.

WHISPER_LANGUAGE=de
# Whisper-Modelle, die beim ersten Start geladen werden (erstes = Standard, siehe WHISPER_MODEL im Dockerfile)
WHISPER_MODELS=large-v3-turbo-q5_0 large-v3-q5_0
# Mit GPU braucht Whisper nur wenige CPU-Threads
WHISPER_THREADS=8

# Ollama: im selben Compose-Projekt (Profil "ollama") oder eine bestehende Instanz/Proxy
OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_FALLBACK_MODEL=gemma4:12b

# Sprechererkennung: pyannote (genauer) braucht ein Hugging-Face-Token mit akzeptierten Nutzungsbedingungen
# von pyannote/speaker-diarization-community-1. Ohne Token: DIARIZATION_ENGINE=sherpa
DIARIZATION_ENGINE=pyannote
# HF_TOKEN=hf_…
# auto = GPU (ROCm-PyTorch) falls vorhanden, sonst CPU
PYANNOTE_DEVICE=auto

# BasaltNotes – unter Linux direkt erreichbar (kein SSH-Tunnel wie auf dem Mac nötig)
# BASALT_URL=http://nas.local:4400
# BASALT_TOKEN=bn_…
# PUBLIC_URL=http://<dieser-rechner>:8000

AUDIO_STORAGE_MAX_GB=50
